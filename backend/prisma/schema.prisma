generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  OWNER
  ADMIN
}

enum SalonStatus {
  DRAFT
  PUBLISHED
  UNPUBLISHED
}

enum WeekDay {
  MONDAY
  TUESDAY
  WEDNESDAY
  THURSDAY
  FRIDAY
  SATURDAY
  SUNDAY
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

model User {
  id                String        @id @default(uuid()) @db.Uuid
  email             String        @unique @db.VarChar(254)
  passwordHash      String        @map("password_hash")
  role              UserRole      @default(CUSTOMER)
  totpSecretEnc     String?       @map("totp_secret_enc")
  totpEnabled       Boolean       @default(false) @map("totp_enabled")
  recoveryCodesHash String[]      @default([]) @map("recovery_codes_hash")
  salons            Salon[]
  bookings          Booking[]
  sessions          UserSession[]
  salonRatings      SalonRating[]
  createdAt         DateTime      @default(now()) @map("created_at")
  updatedAt         DateTime      @updatedAt @map("updated_at")

  @@map("users")
}

model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Salon {
  id            String      @id @default(uuid()) @db.Uuid
  ownerId       String      @map("owner_id") @db.Uuid
  name          String      @db.VarChar(150)
  description   String?     @db.Text
  imageUrl      String?     @map("image_url") @db.Text
  address       String      @db.Text
  city          String      @db.VarChar(100)
  state         String      @db.VarChar(100)
  postalCode    String?     @map("postal_code") @db.VarChar(20)
  phone         String?     @db.VarChar(20)
  googleMapsUrl String?     @map("google_maps_url") @db.Text
  status        SalonStatus @default(DRAFT)
  publishedAt   DateTime?   @map("published_at")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  owner    User           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  services SalonService[]
  hours    SalonHours[]
  ratings  SalonRating[]

  timezone               String        @default("Asia/Kolkata") @db.VarChar(50)
  defaultBookingCapacity Int           @default(50) @map("default_booking_capacity")
  bookingSlots           BookingSlot[]

  @@index([ownerId, createdAt])
  @@index([status, city])
  @@map("salons")
}

model SalonService {
  id           String        @id @default(uuid()) @db.Uuid
  salonId      String        @map("salon_id") @db.Uuid
  name         String        @db.VarChar(120)
  description  String?       @db.Text
  durationMin  Int           @map("duration_min")
  price        Decimal       @db.Decimal(10, 2)
  bookingItems BookingItem[]
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@index([salonId, isActive])
  @@map("salon_services")
}

model SalonHours {
  id       String  @id @default(uuid()) @db.Uuid
  salonId  String  @map("salon_id") @db.Uuid
  day      WeekDay
  opensAt  String? @map("opens_at") @db.VarChar(5)
  closesAt String? @map("closes_at") @db.VarChar(5)
  isClosed Boolean @default(false) @map("is_closed")

  salon Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)

  @@unique([salonId, day])
  @@map("salon_hours")
}

model BookingSlot {
  id          String   @id @default(uuid()) @db.Uuid
  salonId     String   @map("salon_id") @db.Uuid
  startsAt    DateTime @map("starts_at")
  endsAt      DateTime @map("ends_at")
  capacity    Int      @default(50)
  bookedCount Int      @default(0) @map("booked_count")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  salon        Salon  @relation(fields: [salonId], references: [id], onDelete: Cascade)
  serviceItems BookingItem[]
  reservations BookingSlotReservation[]

  @@unique([salonId, startsAt])
  @@index([salonId, startsAt])
  @@map("booking_slots")
}

model Booking {
  id            String        @id @default(uuid()) @db.Uuid
  reference     String        @unique @db.VarChar(30)
  customerId    String        @map("customer_id") @db.Uuid
  status        BookingStatus @default(CONFIRMED)
  ticketKeyHash String        @unique @map("ticket_key_hash")
  ticketKeyEnc  String        @map("ticket_key_enc") @db.Text

  cancelledAt DateTime? @map("cancelled_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  customer User          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    BookingItem[]
  slotReservations BookingSlotReservation[]

  @@index([customerId, status, createdAt])
  @@map("bookings")
}

model BookingItem {
  id                 String   @id @default(uuid()) @db.Uuid
  bookingId          String   @map("booking_id") @db.Uuid
  slotId             String   @map("slot_id") @db.Uuid
  serviceId          String   @map("service_id") @db.Uuid
  serviceName        String   @map("service_name") @db.VarChar(120)
  servicePrice       Decimal  @map("service_price") @db.Decimal(10, 2)
  serviceDurationMin Int      @map("service_duration_min")
  position           Int
  startsAt           DateTime @map("starts_at")
  endsAt             DateTime @map("ends_at")
  createdAt          DateTime @default(now()) @map("created_at")

  booking Booking      @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  slot    BookingSlot  @relation(fields: [slotId], references: [id], onDelete: Restrict)
  service SalonService @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@unique([bookingId, position])
  @@index([slotId])
  @@index([serviceId])
  @@map("booking_items")
}

model BookingSlotReservation {
  bookingId String   @map("booking_id") @db.Uuid
  slotId    String   @map("slot_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  booking Booking     @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  slot    BookingSlot @relation(fields: [slotId], references: [id], onDelete: Restrict)

  @@id([bookingId, slotId])
  @@index([slotId])
  @@map("booking_slot_reservations")
}

model SalonRating {
  id         String   @id @default(uuid()) @db.Uuid
  salonId    String   @map("salon_id") @db.Uuid
  customerId String   @map("customer_id") @db.Uuid
  rating     Int
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  salon    Salon @relation(fields: [salonId], references: [id], onDelete: Cascade)
  customer User  @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([salonId, customerId])
  @@index([salonId])
  @@index([customerId])
  @@map("salon_ratings")
}